# 2. BOSQUEJO A MANO
# temperaturas = [20, 25, 18, 30]
# Un solo recorrido para registrar las temperaturas:
#   recibir cada temperatura
#   agregarla a la lista
# Al final:
#   lista = [20, 25, 18, 30]
# Para la mínima:
#   buscar el valor menor
#   obtener 18
# Para la máxima:
#   buscar el valor mayor
#   obtener 30
# Para el promedio:
#   sumar las temperaturas
#   dividir la suma para la cantidad de temperaturas
#   obtener 23.25
# 3. PATRÓN
# Clase con lista interna para almacenar temperaturas.
# Se utiliza:
# - __init__ para crear la lista de temperaturas.
# - un método para registrar una temperatura.
# - *temps para recibir varias temperaturas.
# - un recorrido for para registrar cada temperatura.
# - append() para guardar las temperaturas.
# - min() para obtener la temperatura mínima.
# - max() para obtener la temperatura máxima.
# - sum() y len() para calcular el promedio.
# - reutilización del método registrar_temperatura()
#   dentro de registrar_multiples().
# 4. CÓDIGO
class GestorTemperatura:
    def __init__(self):
        self.temperaturas = []

    def registrar_temperatura(self, temp):
        self.temperaturas.append(temp)

    def minima(self):
        return min(self.temperaturas)

    def maxima(self):
        return max(self.temperaturas)

    def promedio(self):
        return sum(self.temperaturas) / len(self.temperaturas)

    def registrar_multiples(self, *temps):
        for temp in temps:
            self.registrar_temperatura(temp)

gt = GestorTemperatura()

print(gt.registrar_temperatura(20))
print(gt.registrar_multiples(25, 18, 30))
print(gt.minima())
print(gt.maxima())
print(gt.promedio())

