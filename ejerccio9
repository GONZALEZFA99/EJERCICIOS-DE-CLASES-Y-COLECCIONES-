# 2. BOSQUEJO A MANO
# texto = "Hola123"
# Recorrer cada carácter:
#   H -> consonante
#   o -> vocal
#   l -> consonante
#   a -> vocal
#   1 -> dígito
#   2 -> dígito
#   3 -> dígito
# Contadores:
#   vocales = 2
#   consonantes = 2
#   digitos = 3
# Resultado:
# {'vocales': 2, 'consonantes': 2, 'digitos': 3}
#
# Guardar el texto más largo analizado:
#   si el texto actual es más largo que el almacenado,
#   guardar el texto actual.

# 3. PATRÓN
# Clase con atributo para guardar el texto más largo.
# Se utiliza:
# - __init__ para crear el atributo texto_mas_largo.
# - un método solo_vocales() para identificar vocales.
# - for para recorrer cada carácter.
# - un diccionario para guardar los contadores.
# - reutilización del método solo_vocales().
# - isdigit() para identificar dígitos.
# - len() para comparar la longitud de los textos.
# - if para clasificar los caracteres.

# 4. CÓDIGO

class AnalizadorString:
    def __init__(self):
        self.texto_mas_largo = ""

    def solo_vocales(self, letra):
        return letra.lower() in "aeiou"

    def contar_por_tipo(self, texto):
        resultado = {
            "vocales": 0,
            "consonantes": 0,
            "digitos": 0
        }

        for letra in texto:
            if self.solo_vocales(letra):
                resultado["vocales"] += 1
            elif letra.isdigit():
                resultado["digitos"] += 1
            else:
                resultado["consonantes"] += 1

        if len(texto) > len(self.texto_mas_largo):
            self.texto_mas_largo = texto

        return resultado


astr = AnalizadorString()

print(astr.contar_por_tipo("Hola123"))
print(astr.texto_mas_largo)
