#
# curso_mayor_estudiantes()
#     |
#     --> recorrer cursos
#     --> contar estudiantes
#     --> comparar cantidades
#     --> guardar curso con mayor cantidad
#     --> retornar curso


# 3. PATRÓN
#
# Diccionario de listas.
# El diccionario utiliza el nombre del curso como clave
# y una lista de estudiantes como valor.
#
# Se utiliza un recorrido con for para comparar
# la cantidad de estudiantes de cada curso.


# 4. CÓDIGO

class Cursos:

    def __init__(self):
        self._cursos = {}

    def crear_curso(self, nombre_curso):
        self._cursos[nombre_curso] = []

    def agregar_estudiante(self, curso, estudiante):
        self._cursos[curso].append(estudiante)

    def curso_mayor_estudiantes(self):

        mayor_curso = None
        mayor_cantidad = 0

        for curso, estudiantes in self._cursos.items():
            cantidad = len(estudiantes)

            if cantidad > mayor_cantidad:
                mayor_curso = curso
                mayor_cantidad = cantidad

        return mayor_curso


# USO

c = Cursos()

c.crear_curso("Python")
c.crear_curso("Java")

c.agregar_estudiante("Python", "Ana")
c.agregar_estudiante("Python", "Luis")

c.agregar_estudiante("Java", "Pedro")

print(c.curso_mayor_estudiantes())


