# 3. PATRÓN
# Conjunto (set) para evitar productos duplicados.
# Lista para conservar el orden de los productos.
# Uso de *args para recibir varios productos.
# Reutilización del método agregar_producto().
# Uso de len() para contar los productos únicos.


# 4. CÓDIGO

class RegistroProductos:
    def __init__(self):
        self._palabras = set()
        self._lista = []

    def agregar_producto(self, producto):
        if producto not in self._palabras:
            self._palabras.add(producto)
            self._lista.append(producto)

    def contar_productos(self):
        return len(self._palabras)

    def agregar_varios(self, *args):
        for producto in args:
            self.agregar_producto(producto)


r = RegistroProductos()

r.agregar_varios("pan", "leche", "pan", "arroz", "leche")

print(r.contar_productos())


