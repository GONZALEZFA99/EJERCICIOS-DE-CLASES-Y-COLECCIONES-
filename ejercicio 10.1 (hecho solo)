#
# eliminar_producto(nombre)
#     |
#     --> recorrer _productos
#     --> comparar nombre del producto
#     --> eliminar producto encontrado


# 3. PATRÓN
#
# Lista de tuplas.
# Cada producto se guarda como:
# (nombre, categoria)
#
# Se utiliza un for para recorrer la lista.
# Se utiliza la posición 0 de la tupla para obtener el nombre.
# Se utiliza la posición 1 de la tupla para obtener la categoría.


# 4. CÓDIGO

class ListaCompras:

    def __init__(self):
        self._productos = []

    def agregar_producto(self, nombre, categoria):
        self._productos.append((nombre, categoria))

    def productos_por_categoria(self, categoria):

        resultado = []

        for producto in self._productos:

            if producto[1] == categoria:
                resultado.append(producto)

        return resultado

    def eliminar_producto(self, nombre):

        for producto in self._productos:

            if producto[0] == nombre:
                self._productos.remove(producto)


# USO

lc = ListaCompras()

lc.agregar_producto("Leche", "lacteos")
lc.agregar_producto("Pan", "harina")
lc.agregar_producto("Queso", "lacteos")

print(lc.productos_por_categoria("lacteos"))

lc.eliminar_producto("Leche")

print(lc.productos_por_categoria("lacteos"))


