# 3. PATRÓN
# Diccionario para guardar los libros.
# La clave es el título.
# El valor es la cantidad de páginas.
# Uso de values() para obtener las páginas.
# Uso de items() para recorrer título y páginas.
# Lista para almacenar los libros que cumplen el rango.


# 4. CÓDIGO

class Biblioteca:
    def __init__(self):
        self._libros = {}

    def agregar_libro(self, titulo, paginas):
        self._libros[titulo] = paginas

    def total_paginas(self):
        return sum(self._libros.values())

    def libros_por_rango(self, paginas_min, paginas_max):
        resultado = []

        for titulo, paginas in self._libros.items():
            if paginas >= paginas_min and paginas <= paginas_max:
                resultado.append(titulo)

        return resultado


b = Biblioteca()

b.agregar_libro("Python Basico", 150)
b.agregar_libro("POO", 220)
b.agregar_libro("Algoritmos", 300)
b.agregar_libro("Git", 120)

print(b.total_paginas())

print(b.libros_por_rango(150, 250))


