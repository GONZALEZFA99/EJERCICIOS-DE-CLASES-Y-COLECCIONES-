# }
#
# Para estudiantes_aprobados(80):
#   recorrer estudiante y nota
#   si nota >= 80:
#       agregar estudiante a la lista
#
# Resultado:
# ["Ana"]
#
# Para mejor_estudiante():
#   comparar todas las notas
#
# Ana = 95
# Bob = 70
#
