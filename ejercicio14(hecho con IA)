# 3. PATRÓN
# Clase con diccionario para almacenar información.
# Se utiliza:
# - __init__ para crear el diccionario.
# - un método para registrar estudiantes.
# - diccionario clave-valor.
# - items() para recorrer estudiante y nota.
# - lista para guardar estudiantes aprobados.
# - if para comparar notas.
# - variables para almacenar la mayor nota.
# - tupla para retornar nombre y calificación.


# 4. CÓDIGO

class RegistroNotas:
    def __init__(self):
        self.notas = {}

    def registrar(self, estudiante, nota):
        self.notas[estudiante] = nota

    def estudiantes_aprobados(self, nota_minima):
        aprobados = []

        for estudiante, nota in self.notas.items():
            if nota >= nota_minima:
                aprobados.append(estudiante)

        return aprobados

    def mejor_estudiante(self):
        mayor = 0
        estudiante_mayor = None

        for estudiante, nota in self.notas.items():
            if nota > mayor:
                mayor = nota
                estudiante_mayor = estudiante

        return (estudiante_mayor, mayor)


rn = RegistroNotas()

rn.registrar("Ana", 95)
rn.registrar("Bob", 70)

print(rn.estudiantes_aprobados(80))
print(rn.mejor_estudiante())


