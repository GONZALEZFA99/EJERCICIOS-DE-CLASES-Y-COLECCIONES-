# 2. BOSQUEJO A MANO
# Clase InvertirNombres
#
#     invertir_lista(lista)
#         crear lista resultado
#         recorrer desde el último elemento hasta el primero
#         agregar cada nombre a resultado
#         retornar resultado
#
#     invertir_varias(*listas)
#         crear diccionario resultado
#         para cada lista
#             invertir la lista usando invertir_lista()
#             convertir la lista original en tupla
#             guardar tupla como clave
#             guardar lista invertida como valor
#         retornar resultado


# 3. PATRÓN
# Lista para almacenar los nombres invertidos.
# Uso de range() para recorrer la lista desde el final.
# Uso de *listas para recibir varias listas.
# Reutilización del método invertir_lista().
# Diccionario para relacionar cada lista original con su lista invertida.
# Uso de tuple() para poder utilizar la lista como clave del diccionario.


# 4. CÓDIGO

class InvertirNombres:

    def invertir_lista(self, lista):
        resultado = []

        for i in range(len(lista) - 1, -1, -1):
            resultado.append(lista[i])

        return resultado

    def invertir_varias(self, *listas):
        resultado = {}

        for lista in listas:
            invertida = self.invertir_lista(lista)
            resultado[tuple(lista)] = invertida

        return resultado


inv = InvertirNombres()

print(inv.invertir_lista(["Ana", "Luis", "Pedro"]))

print(inv.invertir_varias(
    ["Ana", "Luis", "Pedro"],
    ["Maria", "Jose"],
    ["Carlos", "Sofia", "Mateo"]
))


