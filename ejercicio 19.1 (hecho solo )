# PROCESO:
# Guardar libros y cantidades en un diccionario.
# Si el libro ya existe, aumentar la cantidad.
# Validar si existe disponibilidad al prestar un libro.
# Disminuir la cantidad cuando se realiza un préstamo.
# Recorrer el diccionario para encontrar libros con poca disponibilidad.
# SALIDA:
# True
# ["Java"]
# COLECCIÓN PRINCIPAL:
# Diccionario como base de datos simple:
# libro -> cantidad


# 2. BOSQUEJO A MANO
#
# Clase Biblioteca
#
#     _libros = {}
#
#
# agregar_libro(titulo, cantidad)
#     |
#     --> Si el libro existe:
#             sumar cantidad nueva
#     --> Si no existe:
#             crear libro con cantidad
#
#
# prestar_libro(titulo)
#     |
#     --> verificar si existe libro
#     --> verificar si cantidad > 0
#     --> disminuir cantidad en 1
#     --> retornar True
#     --> si no hay disponibilidad retornar False
#
#
# libros_bajo_disponibilidad(minimo)
#     |
#     --> crear lista resultado
#     --> recorrer libros con items()
#     --> comparar cantidad con mínimo
#     --> guardar libros que cumplan condición


# 3. PATRÓN
#
# Diccionario como acumulador de cantidades.
# La clave representa el título del libro.
# El valor representa la cantidad disponible.
#
# Se utiliza:
# - if para comprobar existencia.
# - items() para recorrer clave y valor.
# - lista para almacenar resultados filtrados.


# 4. CÓDIGO


class Biblioteca:

    def __init__(self):
        self._libros = {}


    def agregar_libro(self, titulo, cantidad):

        if titulo in self._libros:

            self._libros[titulo] += cantidad

        else:

            self._libros[titulo] = cantidad



    def prestar_libro(self, titulo):

        if titulo in self._libros:

            if self._libros[titulo] > 0:

                self._libros[titulo] -= 1

                return True

        return False



    def libros_bajo_disponibilidad(self, minimo):

        resultado = []

        for titulo, cantidad in self._libros.items():

            if cantidad < minimo:

                resultado.append(titulo)

        return resultado



# USO

b = Biblioteca()

b.agregar_libro("Python", 5)
b.agregar_libro("Java", 2)

print(b.prestar_libro("Python"))

print(b.libros_bajo_disponibilidad(3))


