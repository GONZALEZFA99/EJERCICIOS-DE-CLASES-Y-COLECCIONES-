# 3. PATRÓN
# Lista para almacenar las notas.
# Uso de *notas para recibir varias notas.
# Reutilización del método registrar_nota().
# Uso de min() para obtener la nota más baja.
# Uso de max() para obtener la nota más alta.
# Uso de sum() y len() para calcular el promedio.


# 4. CÓDIGO

class GestorCalificaciones:
    def __init__(self):
        self._notas = []

    def registrar_nota(self, nota):
        self._notas.append(nota)

    def registrar_multiples(self, *notas):
        for nota in notas:
            self.registrar_nota(nota)

    def nota_minima(self):
        return min(self._notas)

    def nota_maxima(self):
        return max(self._notas)

    def promedio(self):
        return sum(self._notas) / len(self._notas)


g = GestorCalificaciones()

g.registrar_multiples(85, 90, 75, 100)

print(g.nota_minima())

print(g.nota_maxima())

print(g.promedio())


