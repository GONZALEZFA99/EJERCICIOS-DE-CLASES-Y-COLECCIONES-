# 3. PATRÓN
#
# Diccionario utilizado como contador de frecuencias.
# La clave representa la palabra.
# El valor representa la cantidad de veces que aparece.
#
# Se utiliza:
# - if para comprobar si la palabra existe.
# - items() para recorrer palabra y cantidad.
# - variable auxiliar para guardar el máximo.
# - get() para obtener valores evitando errores.


# 4. CÓDIGO

class ContadorPalabras:

    def __init__(self):
        self._palabras = {}

    def agregar_palabra(self, palabra):

        if palabra in self._palabras:
            self._palabras[palabra] += 1

        else:
            self._palabras[palabra] = 1


    def palabra_mas_repetida(self):

        mayor_palabra = None
        mayor_cantidad = 0

        for palabra, cantidad in self._palabras.items():

            if cantidad > mayor_cantidad:
                mayor_palabra = palabra
                mayor_cantidad = cantidad

        return mayor_palabra


    def cantidad_palabra(self, palabra):

        return self._palabras.get(palabra, 0)



# USO

cp = ContadorPalabras()

cp.agregar_palabra("python")
cp.agregar_palabra("java")
cp.agregar_palabra("python")
cp.agregar_palabra("python")

print(cp.palabra_mas_repetida())

print(cp.cantidad_palabra("python"))


