# 3. PATRÓN
# Clase con diccionario de listas.
# Se utiliza:
# - __init__ para crear el diccionario de equipos.
# - un método para crear equipos.
# - una lista vacía para almacenar los jugadores.
# - append() para agregar jugadores.
# - items() para recorrer los equipos y sus jugadores.
# - len() para contar los jugadores.
# - if para comparar la cantidad de integrantes.

# 4. CÓDIGO

class Equipos:
    def __init__(self):
        self.equipos = {}

    def crear_equipo(self, nombre_equipo):
        self.equipos[nombre_equipo] = []

    def agregar_jugador(self, equipo, jugador):
        self.equipos[equipo].append(jugador)

    def equipo_mayor_integrantes(self):
        mayor = 0
        equipo_mayor = None

        for equipo, jugadores in self.equipos.items():
            if len(jugadores) > mayor:
                mayor = len(jugadores)
                equipo_mayor = equipo

        return equipo_mayor


eq = Equipos()

eq.crear_equipo("A")
eq.crear_equipo("B")

eq.agregar_jugador("A", "Juan")
eq.agregar_jugador("A", "Pedro")

eq.agregar_jugador("B", "Luis")

print(eq.equipo_mayor_integrantes())


