# 2. BOSQUEJO A MANO
#
# Clase AnalizadorPalabras
#
#     _palabras = []
#
#
# buscar_por_inicio(texto, letra)
#     |
#     --> separar texto en palabras
#     --> recorrer palabras
#     --> verificar inicio con startswith()
#     --> guardar palabra encontrada
#     --> guardar palabra en historial
#     --> retornar lista
#
#
# agrupar_por_tamaño(texto)
#     |
#     --> crear diccionario grupos
#     --> separar palabras
#     --> obtener tamaño con len()
#     --> si tamaño no existe crear lista
#     --> agregar palabra al grupo
#     --> guardar palabra en historial
#     --> retornar diccionario
#
#
# palabras_sin_repetir()
#     |
#     --> convertir lista a set()
#     --> retornar palabras únicas


# 3. PATRÓN
#
# Uso de split() para separar un texto.
# Uso de startswith() para buscar palabras por letra inicial.
# Uso de len() para conocer cantidad de caracteres.
# Diccionario con listas para agrupar datos.
# Set para eliminar valores repetidos.


# 4. CÓDIGO


class AnalizadorPalabras:

    def __init__(self):

        self._palabras = []


    def buscar_por_inicio(self, texto, letra):

        resultado = []

        palabras = texto.split()


        for palabra in palabras:

            if palabra.startswith(letra):

                resultado.append(palabra)

                self._palabras.append(palabra)


        return resultado



    def agrupar_por_tamaño(self, texto):

        grupos = {}

        palabras = texto.split()


        for palabra in palabras:

            tamaño = len(palabra)


            if tamaño not in grupos:

                grupos[tamaño] = []


            grupos[tamaño].append(palabra)

            self._palabras.append(palabra)


        return grupos



    def palabras_sin_repetir(self):

        return set(self._palabras)



# USO

ap = AnalizadorPalabras()


print(ap.buscar_por_inicio(
    "perro pato gato pez",
    "p"
))


print(ap.agrupar_por_tamaño(
    "sol perro gato"
))


print(ap.palabras_sin_repetir())



