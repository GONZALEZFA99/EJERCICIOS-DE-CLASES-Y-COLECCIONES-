# 3. PATRÓN
# Clase que trabaja con procesamiento de textos.
#
# Se utiliza:
# - __init__ para crear un conjunto de palabras.
# - split() para separar el texto.
# - startswith() para buscar patrones.
# - len() para obtener longitud de palabras.
# - diccionario para agrupar información.
# - lista para almacenar palabras.
# - set() para eliminar duplicados.
# - add() para agregar elementos únicos.


# 4. CÓDIGO

class AnalizadorPatrones:

    def __init__(self):
        self.unicas = set()


    def encontrar_palabras(self, texto, patron):

        resultado = []

        palabras = texto.split()

        for palabra in palabras:

            if palabra.startswith(patron):
                resultado.append(palabra)

            self.unicas.add(palabra)

        return resultado


    def agrupar_por_longitud(self, texto):

        grupos = {}

        palabras = texto.split()

        for palabra in palabras:

            longitud = len(palabra)

            if longitud not in grupos:
                grupos[longitud] = []

            grupos[longitud].append(palabra)

            self.unicas.add(palabra)

        return grupos


    def palabras_unicas(self):

        return self.unicas



ap = AnalizadorPatrones()

print(ap.encontrar_palabras("casa carro perro camino", "ca"))

print(ap.agrupar_por_longitud("el gato está aquí"))

print(ap.palabras_unicas())


