# La palabra codificada.


# 2. BOSQUEJO A MANO
# palabra = "hola"
# desplazamiento = 3
#
# Procesar letra por letra:
#
# h -> k
# o -> r
# l -> o
# a -> d
#
# Resultado:
# "krod"
#
# Guardar historial:
#
# {
#   "hola": "krod"
# }


# 3. PATRÓN
# Clase con atributo diccionario para guardar información.
#
# Se utiliza:
# - __init__ para crear el historial.
# - ord() para convertir letras en códigos ASCII.
# - chr() para convertir códigos en letras.
# - operador % para mantener el desplazamiento dentro
#   del alfabeto.
# - for para recorrer la palabra.
# - reutilización del método codificar_letra().
# - diccionario para guardar las codificaciones.


# 4. CÓDIGO

class CodificadorCesar:

    def __init__(self):
        self.historial = {}

    def codificar_letra(self, letra, desplazamiento):
        codigo = ord(letra)

        nuevo_codigo = ((codigo - ord('a') + desplazamiento) % 26) + ord('a')

        return chr(nuevo_codigo)

    def codificar_palabra(self, palabra, desplazamiento):
        resultado = ""

        for letra in palabra:
            resultado += self.codificar_letra(letra, desplazamiento)

        self.historial[palabra] = resultado

        return resultado


cc = CodificadorCesar()

print(cc.codificar_palabra("hola", 3))
print(cc.historial)


