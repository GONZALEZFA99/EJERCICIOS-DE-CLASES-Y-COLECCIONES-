# Guardar los números que no son múltiplos de 3 en otra lista.
# Contar la cantidad de elementos de cada lista.
#
# SALIDA:
# {'multiplos': [3, 6, 9], 'no_multiplos': [4, 8, 10]}
# (3, 3)


# 2. BOSQUEJO A MANO
# Clase ClasificadorNumeros
#     _multiplo_de_3 = []
#     _no_es_multiplo_de_3 = []
#
#     es_multiplo_de_tres(numero)
#         Si numero % 3 == 0
#             retornar True
#         Si no
#             retornar False
#
#     separar(*numeros)
#         Para cada numero
#             Si es multiplo de 3
#                 guardar en _multiplo_de_3
#             Si no
#                 guardar en _no_es_multiplo_de_3
#         retornar diccionario
#
#     cantidad_multiplos_no_multiplos()
#         retornar cantidad de múltiplos
#         retornar cantidad de no múltiplos


# 3. PATRÓN
# Dos listas para separar los números.
# Uso del operador % para comprobar si un número es múltiplo de 3.
# Uso de *numeros para recibir varios números.
# Reutilización del método es_multiplo_de_tres().
# Diccionario para retornar las dos listas.
# Tupla para retornar las cantidades.


# 4. CÓDIGO

class ClasificadorNumeros:
    def __init__(self):
        self._multiplo_de_3 = []
        self._no_es_multiplo_de_3 = []

    def es_multiplo_de_tres(self, numero):
        if numero % 3 == 0:
            return True
        else:
            return False

    def separar(self, *numeros):
        for numero in numeros:
            if self.es_multiplo_de_tres(numero):
                self._multiplo_de_3.append(numero)
            else:
                self._no_es_multiplo_de_3.append(numero)

        return {
            "multiplos": self._multiplo_de_3,
            "no_multiplos": self._no_es_multiplo_de_3
        }

    def cantidad_multiplos_no_multiplos(self):
        return (
            len(self._multiplo_de_3),
            len(self._no_es_multiplo_de_3)
        )


c = ClasificadorNumeros()

print(c.separar(3, 4, 6, 8, 9, 10))

print(c.cantidad_multiplos_no_multiplos())


