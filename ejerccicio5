# ------------------------------------------------------------
# 2. BOSQUEJO A MANO
# ------------------------------------------------------------
#
# numeros = [1, 2, 3, 4, 5]
#
# Crear:
#   lista de pares
#   lista de impares
#
# Un solo recorrido:
#   revisar cada número
#   si numero % 2 == 0:
#       agregarlo a pares
#   caso contrario:
#       agregarlo a impares
#
# Al final:
#   pares = [2, 4]
#   impares = [1, 3, 5]
#
# Construir diccionario:
#   "pares" -> lista de pares
#   "impares" -> lista de impares
#
# Contar:
#   cantidad de pares = 2
#   cantidad de impares = 3


# ------------------------------------------------------------
# 3. PATRÓN
# ------------------------------------------------------------
#
# Clasificación de elementos en dos grupos.
#
# Se utiliza:
# - __init__ para crear las listas de pares e impares.
# - % para determinar si un número es par.
# - True / False en el método es_par().
# - *numeros para recibir varios números.
# - for para recorrer los números.
# - reutilización del método es_par().
# - append() para guardar números en las listas.
# - un diccionario para retornar pares e impares.
# - len() para contar los elementos.
# - una tupla para retornar las dos cantidades.


# ------------------------------------------------------------
# 4. CÓDIGO
# ------------------------------------------------------------

class AnalizadorNumeros:
    def __init__(self):
        self.pares = []
        self.impares = []

    def es_par(self,numero):
        if numero % 2 == 0:
            return True
        else:
            return False

    def separar(self,*numeros):
        for numero in numeros:
            if self.es_par(numero):
                self.pares.append(numero)
            else:
                self.impares.append(numero)

        return {
            "pares": self.pares,
            "impares": self.impares
        }

    def cantidad_pares_impares(self):
        return (len(self.pares),len(self.impares))


an = AnalizadorNumeros()

print(an.separar(1,2,3,4,5))
print(an.cantidad_pares_impares())


